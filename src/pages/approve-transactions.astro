---
import ApproveTransactions from "../components/ApproveTransactions.vue";
import Layout from "../layouts/Layout.astro";
import { fetchPendingEntries } from "../lib/queries";

if (!Astro.locals.user) {
	return Astro.redirect("/login");
}

if (Astro.locals.user.role !== "admin") {
	return Astro.redirect("/dashboard");
}

const PAGE_SIZE = 20;
const page = Math.max(
	1,
	parseInt(Astro.url.searchParams.get("page") ?? "1", 10),
);

const { entries: initialGroups, total } = await fetchPendingEntries(
	page,
	PAGE_SIZE,
);
---

<Layout title="Approve Transactions">
	<div class="max-w-5xl mx-auto px-4 xs:px-6 py-10">
		<!-- Header -->
		<div class="mb-8">
			<p class="font-mono text-xs uppercase tracking-widest text-muted mb-2">
				Admin
			</p>
			<h1
				class="text-[clamp(1.75rem,5vw,2.5rem)] font-[340] leading-none tracking-[-0.03em]"
			>
				Approve Transactions
			</h1>
			<p class="text-sm text-muted font-[330] mt-2">
				{total}&nbsp;pending transaction{total === 1 ? "" : "s"}&nbsp; awaiting
				review
			</p>
		</div>

		<ApproveTransactions
			client:only="vue"
			initialGroups={initialGroups}
			initialTotal={total}
			initialPage={page}
			pageSize={PAGE_SIZE}
		/>
	</div>
</Layout>
